#!/bin/sh
#
# run_test - compile one test file, run it, and check what it claims.

set -u

PROG=$(basename "$0")
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

COMPILER="$HERE/build/bin/ivan-cc"
TIMEOUT=5
HEAD_LINES=10
SOURCE=${1:-}

# Report a problem with the run itself rather than with the test, and exit.
error()
{
    printf '%s: %s\n' "$PROG" "$*" >&2
    exit 2
}

# Report a passing test and exit.
pass()
{
    printf '\033[32mPASS\033[0m: %s\n' "$SOURCE"
    exit 0
}

# Report a failing test and exit, indenting the reason by four spaces.
fail()
{
    printf '\033[31mFAIL\033[0m: %s\n' "$SOURCE"
    printf '%s\n' "$*" | sed 's/^/    /'
    exit 1
}

# Echo the value of a `// (Test) <key>:` directive, or nothing if the file
# declares none. Keys match case-insensitively; `Return` is the spelling to use.
get_value()
{
    head -n "$HEAD_LINES" "$SOURCE" \
        | sed -n "s@^[[:space:]]*//[[:space:]]*(Test)[[:space:]]*$1[[:space:]]*:[[:space:]]*@@Ip" \
        | sed 's/[[:space:]]*$//' \
        | head -n 1
}

# Compile the test, run it, and check its status against `// (Test) Return:`.
do_test()
{
    [ -n "$SOURCE" ] || error "no test file given"
    [ -f "$SOURCE" ] || error "no such file: $SOURCE"
    [ -x "$COMPILER" ] || error "compiler not executable: $COMPILER"

    EXPECT=$(get_value 'return')

    [ -n "$EXPECT" ] || fail "No expectation declared"

    case $EXPECT in
        *[!0-9]*) fail "Return expects a number between 0 and 255, got '$EXPECT'" ;;
    esac

    [ "$EXPECT" -le 255 ] || fail "Return expects a number between 0 and 255, got '$EXPECT'"

    WORK_DIR=$(mktemp -d) || error "cannot create a temporary directory"
    trap 'rm -rf "$WORK_DIR"' EXIT INT TERM

    BINARY="$WORK_DIR/a.out"
    COMPILE_ERR="$WORK_DIR/compile.err"

    "$COMPILER" "$SOURCE" -o "$BINARY" >"$COMPILE_ERR" 2>&1 || fail "Compilation failed\n$(cat "$COMPILE_ERR")"

    timeout "$TIMEOUT" "$BINARY" >/dev/null 2>&1

    STATUS=$?

    # Checked before the signal cases below, which a status of 204 is otherwise
    # indistinguishable from.
    [ "$STATUS" -ne "$EXPECT" ] || pass
    [ "$STATUS" -ne 124 ] || fail "Timed out after ${TIMEOUT}s"
    [ "$STATUS" -le 128 ] || fail "Died from signal $((STATUS - 128)), expected to return $EXPECT"

    fail "Returned $STATUS but expected $EXPECT"
}

do_test
